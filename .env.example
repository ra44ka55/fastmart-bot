# QuickCommerce Stock Tracker - Environment Variables
# Copy this file to .env and fill in the values

# ── REQUIRED ──────────────────────────────────────────────────────────────────
# Telegram Bot Token (from @BotFather)
TELEGRAM_BOT_TOKEN=

# QuickCommerce API Key
QC_API_KEY=

# ── OPTIONAL ──────────────────────────────────────────────────────────────────
# Server port (Railway sets this automatically)
PORT=3000

# Internal server URL (leave as-is for Railway)
SERVER_URL=http://localhost:3000

# Max Instamart stores to scan per /find query (default: 30, max: 112)
MAX_STORES=30

# Indian residential proxy for Playwright scraper (optional, avoids IP blocks)
# Format: http://username:password@proxyhost:port
PROXY_URL=
